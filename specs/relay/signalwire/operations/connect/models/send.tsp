import "@signalwire/typespec-asyncapi";

using SignalWire.AsyncAPI;

namespace Relay.Signalwire;

@doc("""
  The Relay protocol version a **server** connection speaks. The server SDKs send
  `2.0.0`. Calling events, `messaging.send`, `signalwire.provision`, and
  `signalwire.receive`/`signalwire.unreceive` all require a `major` below `4`: at `4`
  or higher, Calling events are not delivered as documented here and those methods
  are rejected with `-32001`. The service rejects any `major` above `4` and any
  non-zero `minor`.
  """)
@summary("Protocol version (server)")
model ServerVersion {
  @doc("Major version. The server SDKs send `2`. Must be below `4` for the server methods and events to work.")
  @example(2)
  major: int32;

  @doc("Minor version. Must be `0` — the service rejects any non-zero minor.")
  @example(0)
  minor: int32;

  @doc("Revision. The server SDKs send `0`.")
  @example(0)
  revision: int32;
}

@doc("""
  The Relay protocol version a **client** connection speaks. Browser and Call Fabric
  clients send `4.0.0`. Call Fabric (`call.*`, `subscriber.*`) requires `major` `4`;
  lower versions are rejected with `-32001`. The service rejects any `major` above `4`
  and any non-zero `minor`.
  """)
@summary("Protocol version (client)")
model ClientVersion {
  @doc("Major version. Browser and Call Fabric clients send `4`, the highest the service accepts.")
  @example(4)
  major: int32;

  @doc("Minor version. Must be `0` — the service rejects any non-zero minor.")
  @example(0)
  minor: int32;

  @doc("Revision. Browser and Call Fabric clients send `0`.")
  @example(0)
  revision: int32;
}

@doc("""
  Client authentication, for browser and mobile apps. Send a `jwt_token` that your
  backend mints and hands to the client — for Call Fabric a **Subscriber Access Token
  (SAT)**; a Video room token or Chat token also works on its own. A Relay JWT created
  with the Relay REST API must be sent together with its `project`. Never ship a
  project API token to the browser.
  """)
model JwtAuthentication {
  @doc("The token that authenticates this client — a Subscriber Access Token (SAT) for Call Fabric, generated by your backend.")
  @example("eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.payload.sig")
  jwt_token: string;

  @doc("""
    Your SignalWire Project ID. Required when `jwt_token` is a Relay JWT created with
    the Relay REST API; omit it for a Subscriber Access Token, Video room token, or
    Chat token.
    """)
  @example("b1c2d3e4-f5a6-7b8c-9d0e-1f2a3b4c5d6e")
  project?: string;
}

@doc("""
  Server authentication, for backend apps that hold your SignalWire credentials
  directly — your Project ID and API token.
  """)
model ProjectTokenAuthentication {
  @doc("Your SignalWire Project ID.")
  @example("b1c2d3e4-f5a6-7b8c-9d0e-1f2a3b4c5d6e")
  project: string;

  @doc("Your SignalWire API token.")
  @example("PT1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d")
  token: string;
}

@doc("Connection parameters common to every `signalwire.connect`, regardless of how you authenticate.")
model ConnectParamsBase {
  @doc("A label identifying your SDK and application, for example `my-voice-app/1.0.0`.")
  @example("my-voice-app/1.0.0")
  agent?: string;

  @doc("""
    The protocol identifier to resume. Provide this to rejoin a protocol you
    established earlier, when your project's permissions allow it.
    """)
  @example("signalwire_c1d2e3f4a5b6")
  protocol?: string;

  @doc("""
    Authorization state from an earlier `signalwire.authorization.state` event.
    Pass it back when reconnecting to restore your permissions and state. Treat it
    as an opaque token — store the value you received and return it unchanged. When
    you set this, you must also set `protocol`; the service rejects an
    `authorization_state` sent without a `protocol`.
    """)
  @example("eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIn0..aBcDeF:Z9y8x7w6v5")
  authorization_state?: string;

  @doc("""
    Accepted for compatibility but has no effect. Events are delivered as
    notifications, and the service does not wait for or read acknowledgements.
    """)
  @example(true)
  event_acks?: boolean;
}

@doc("""
  The parameters you send with `signalwire.connect` from a **backend/server** app:
  your Project ID + API token, protocol version (`2.0.0`), and any contexts to
  subscribe to.
  """)
@summary("Connect parameters (server)")
model ServerConnectParams {
  @doc("Your backend credentials — Project ID + API token.")
  authentication: ProjectTokenAuthentication;

  @doc("The Relay protocol version your app speaks. The server SDKs send `2.0.0`.")
  version: ServerVersion;

  ...ConnectParamsBase;

  @doc("""
    Contexts to start receiving inbound events for as soon as you connect — the
    contexts your inbound calls, messages, and tasks are routed to. You can add or
    remove contexts later with `signalwire.receive` and `signalwire.unreceive`.
    """)
  @example(#["office", "support"])
  contexts?: string[];
}

@doc("""
  The parameters you send with `signalwire.connect` from a **browser/client** app:
  your `jwt_token` (a Subscriber Access Token for Call Fabric), protocol version
  (`4.0.0`), and any contexts to subscribe to.
  """)
@summary("Connect parameters (client)")
model ClientConnectParams {
  @doc("Your client credential — a `jwt_token` / Subscriber Access Token (SAT).")
  authentication: JwtAuthentication;

  @doc("The Relay protocol version your client speaks. Browser and Call Fabric clients send `4.0.0`.")
  version: ClientVersion;

  ...ConnectParamsBase;

  @doc("Contexts to start receiving inbound events for as soon as you connect.")
  @example(#["office", "support"])
  contexts?: string[];

  @doc("""
    Optional proof-of-possession token that cryptographically binds this connection
    to your client. Only needed for advanced DPoP token-binding flows (a bound SAT);
    leave it unset otherwise.
    """)
  @example("eyJ0eXAiOiJkcG9wK2p3dCIsImFsZyI6IkVTMjU2In0.eyJodG0iOiJQT1NUIn0.sig")
  dpop_token?: string;
}
